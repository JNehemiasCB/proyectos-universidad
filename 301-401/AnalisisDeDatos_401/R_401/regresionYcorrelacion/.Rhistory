edad <- c(56, 42, 72, 36, 63, 47, 55, 47, 38, 42)
presion <- c(148, 126, 159, 118, 149, 130, 151, 142, 114, 141)
plot(presion, edad)
reg_lin <- lm(edad ~ presion)
reg_lin
summary(reg_lin)
plot(presion, edad)
abline(reg_lin)
plot(reg_lin)
plot(reg_lin)
ks.test(reg_lin$residuals, "pnorm")
install.packages("lmtest")
library(lmtest)
dwtest(edad ~ presion)
edad <- c(56, 42, 72, 36, 63, 47, 55, 47, 38, 42)
presion <- c(148, 126, 159, 118, 149, 130, 151, 142, 114, 141)
plot(presion, edad)
reg_lin <- lm(edad ~ presion)
reg_lin
summary(reg_lin)
plot(presion, edad)
abline(reg_lin)
plot(reg_lin)
ks.test(reg_lin$residuals, "pnorm")
dwtest(edad ~ presion)
gastos <- c (1000, 580, 520, 500, 600, 550, 400)
ingresos <- c (50000, 2500, 2000, 1900, 3000, 4000, 2000)
tamaño <- c (7, 4, 3, 3, 6, 5, 2)
hijosU <- c (3, 1, 1, 0, 1, 2, 0)
GastoAlim <- data.frame (gastos, ingresos, tamaño, hijosU)
GastoAlim
reg_lin_mul <- lm ( gastos ~ ingresos + tamaño + hijosU)
summary(reg_lin_mul)
#Actividad 9
cor(gastos, ingresos)
cor(GastoAlim)
cor.test(gastos, ingresos)
#Actividad 10
lm (formula = gastos ~ ingresos + tamaño ^ 2 )
ventas <- c (10, 12, 11, 13, 12, 14, 16, 12, 14, 11, 10, 19, 8.5, 8, 9 ,13, 16, 18, 20, 22)
tv <- c(13, 14, 15, 17, 17.5, 13, 14.5, 9, 8, 9, 8, 10, 17, 18, 18.5, 19, 20, 20, 13, 14)
radio <- c(56, 55, 60 ,65, 69, 67, 68, 67, 97, 66, 65, 60, 70, 110, 75, 80, 85, 90, 56, 55)
periodicos <- c(40, 40, 42, 50, 40, 44, 46, 46, 45, 110, 30, 50, 45, 40, 80, 90, 90 ,110)
cereales <- data.frame(ventas, tv, radio, periodicos)
ventas <- c (10, 12, 11, 13, 12, 14, 16, 12, 14, 11, 10, 19, 8.5, 8, 9 ,13, 16, 18, 20, 22)
tv <- c(13, 14, 15, 17, 17.5, 13, 14.5, 9, 8, 9, 8, 10, 17, 18, 18.5, 19, 20, 20, 13, 14)
radio <- c(56, 55, 60 ,65, 69, 67, 68, 67, 97, 66, 65, 60, 70, 110, 75, 80, 85, 90, 56, 55)
periodicos <- c(40, 40, 42, 50, 40, 44,40, 44, 46, 46, 45, 110, 30, 50, 45, 40, 80, 90, 90 ,110)
cereales <- data.frame(ventas, tv, radio, periodicos)
cereales
plot(cereales$ventas, cereales$tv)
reg_lin <- lm (ventas ~ tv, data = cereales)
reg_lin
summary (reg_lin)
reg_lin2 <- lm(ventas ~ 0 + tv, datda = cereales)
reg_lin2
cor.test(cereales$ventas, cereales $tv)
reg_lin_mul <- lm(ventas ~ tv + radio, data = cereales)
reg_lin_mul
reg_lin_mul2 <- lm(ventas ~ tv + radio + periodicos, data = cereales)
reg_lin_mul2
summary(reg_lin_mul2)
nivcloro <- c(2.2,1.9,1.7,1.6,1.7,1.8,1.7,1.9,2,2)
nivcloro
mean(nivcloro)
ventasA <- c(1320,1495,990,1250,12900,1900,1500,1100,1250,1100,1930)
ventasB <- c(1110,1405,985,1290,1300,1705,1200,1105,1150,1210,NA)
datos <- as.data.frame(cbind(ventasA, ventasB))
datos
attach(datos)
ventasA
ventasB
mean(ventasA, na.rm = T); mean(ventasB, na.rm = T)
var(nivcloro)
sd(nivcloro)
var(ventasA); var(ventasB, na.rm = T)
sd(ventasA); sd(ventasB, na.rm = T)
t.test(nivcloro, conf.level = 0.99)$conf
round(c(9*var(nivcloro)/qchisq(0.995, 9),9*var(nivcloro)/qchisq(0.005,9)),4)
IC.para.la.varianza<-function (x,alfa)
+round(c((length(x)-1)*var(x)/qchisq (1-alfa/2, length(x)-1),
+(length(x)-1)*var(x)/qchisq (alfa/2, length(x)-1)),4)
IC.para.la.varianza (x=nivcloro, alfa=0.01)
IC.para.la.varianza(nivcloro,0.05)
var.test(ventasA,ventasB)$conf
t.test(ventasA,ventasB,var.equal = F)$conf
12/150
prop.test(12,150)$conf
valores <- rnorm(20,10,2)
t.test(valores)$conf
IC.varianza <- c(9*var(valores)/qchisq(0.975,9),9*var(valores)/qchisq(0.025,9))
IC.varianza
muestra1 <- rnorm(50,0,1)
muestra2 <- rnorm(50,0,5)
a <- t.test(muestra1)$conf
b <- t.test(muestra2)$conf
a
b
