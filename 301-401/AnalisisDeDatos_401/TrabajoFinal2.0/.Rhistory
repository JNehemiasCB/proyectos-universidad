# 2. Crear el mapa de calor
ggplot(datos_mapa_calor,
aes(x = Año, y = reorder(Entidad, Valor), fill = Valor)) +
geom_tile(color = "white", linewidth = 0.5) +  # Bordes blancos para mejor visualización
scale_fill_gradient(low = "white", high = "red",
name = "Pobreza extrema\n(miles de personas)") +
labs(title = "Evolución de pobreza extrema por estado (2018-2022)",
x = "Año",
y = "") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 0, hjust = 0.5),
axis.text.y = element_text(size = 8))  # Ajustar tamaño de letra para estados
datos_2022 <- datos_largos %>% filter(Año == 2022)
ggplot(datos_2022, aes(x = reorder(Entidad, Valor), y = Valor, fill = Tipo)) +
geom_bar(stat = "identity") +
coord_flip() +
labs(title = "Composición de la pobreza en 2022", x = "", y = "Personas (miles)")
estados_filtro <- c("Chiapas", "Guerrero", "Nuevo León", "Ciudad de México")
ggplot(pobreza_extrema %>% filter(Entidad %in% estados_filtro),
aes(x = Año, y = Valor, color = Entidad, group = Entidad)) +
geom_line(linewidth = 1.5) +
geom_point(size = 3) +
labs(title = "Tendencia de pobreza extrema (2018-2022)", y = "Personas (miles)")
datos_2022_wide <- datos_largos %>%
filter(Año == 2022) %>%
pivot_wider(names_from = Tipo, values_from = Valor)
ggplot(datos_2022_wide, aes(x = Pobreza_moderada, y = Pobreza_extrema, label = Entidad)) +
geom_point(color = "blue") +
ggrepel::geom_text_repel(size = 3) +  # Evita superposición de etiquetas
labs(title = "Relación entre pobreza moderada y extrema (2022)")
datos_2022_wide <- datos_largos %>%
filter(Año == 2022) %>%
pivot_wider(names_from = Tipo, values_from = Valor)
# 1. Asegurarnos de que los datos están en el formato correcto
datos_mapa_calor <- datos_largos %>%
filter(Tipo == "Pobreza_extrema") %>%
mutate(Año = as.factor(Año),
Entidad = factor(Entidad))
# 2. Crear el mapa de calor
ggplot(datos_mapa_calor,
aes(x = Año, y = reorder(Entidad, Valor), fill = Valor)) +
geom_tile(color = "white", linewidth = 0.5) +  # Bordes blancos para mejor visualización
scale_fill_gradient(low = "white", high = "red",
name = "Pobreza extrema\n(miles de personas)") +
labs(title = "Evolución de pobreza extrema por estado (2018-2022)",
x = "Año",
y = "") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 0, hjust = 0.5),
axis.text.y = element_text(size = 8))  # Ajustar tamaño de letra para estados
library(ggplot2)
ggplot(pobreza_extrema, aes(x = as.factor(Año), y = Valor)) +
geom_boxplot(fill = "#F8766D", alpha = 0.7) +
labs(title = "Distribución nacional de pobreza extrema",
x = "Año", y = "Personas (miles)") +
theme_minimal()
ggplot(pobreza_extrema, aes(x = as.factor(Año), y = Valor)) +
geom_violin(fill = "lightblue", trim = FALSE) +
geom_jitter(width = 0.1, alpha = 0.5, color = "darkblue") +
labs(title = "Densidad y dispersión por año", x = "Año") +
theme_classic()
pobreza_extrema %>%
group_by(Año) %>%
mutate(Media_Nacional = mean(Valor),
Desviacion = Valor - Media_Nacional) %>%
ggplot(aes(x = reorder(Entidad, Desviacion), y = Desviacion, fill = Desviacion > 0)) +
geom_col() +
facet_wrap(~Año, scales = "free_y") +
coord_flip() +
scale_fill_manual(values = c("blue", "red")) +
labs(title = "Desviación respecto a la media nacional", x = "") +
theme(legend.position = "none")
pobreza_extrema %>%
group_by(Entidad) %>%
mutate(Cambio = (Valor - first(Valor)) / first(Valor) * 100) %>%
ggplot(aes(x = as.factor(Año), y = reorder(Entidad, Cambio), fill = Cambio)) +
geom_tile(color = "white") +
scale_fill_gradient2(low = "blue", mid = "white", high = "red", midpoint = 0) +
labs(title = "Cambio porcentual (2018-2022)", x = "Año", y = "") +
theme_minimal()
