Proceso distanciaViajada
	Definir dist, tiempo Como Real;
	dist<- 60*5;
	Escribir "la distancia realizada por recorrer 60 millas por 5 horas es de: ", dist," millas";
	dist<- 60*8;
	Escribir "la distancia realizada por recorrer 60 millas por 8 horas es: ", dist," millas";
	dist<- 60*12;
	Escribir "la distancia realizada por recorrer 60 millas por 12 horas es: ", dist," millas";
FinProceso
